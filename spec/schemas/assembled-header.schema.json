{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intent:schema:assembled-header:v2",
  "title": "Intent assembled Knowledge metadata v2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "intent.knowledge-record.v2"
    },
    "kind": {
      "$ref": "urn:intent:schema:common:v1#/$defs/kind"
    },
    "id": {
      "$ref": "urn:intent:schema:common:v1#/$defs/knowledgeId"
    },
    "status": {
      "$ref": "urn:intent:schema:common:v1#/$defs/status"
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "urn:intent:schema:common:v1#/$defs/opaqueId"
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "urn:intent:schema:common:v1#/$defs/source"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "urn:intent:schema:common:v1#/$defs/opaqueId"
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverageSelector"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "urn:intent:schema:common:v1#/$defs/subject"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "evidenceKinds": {
      "type": "array",
      "items": {
        "$ref": "urn:intent:schema:common:v1#/$defs/evidenceKind"
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "kind",
    "id",
    "status",
    "owners",
    "sources",
    "relationships",
    "conflicts",
    "tags"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": {}
  },
  "$defs": {
    "relationship": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "refines",
            "constrains",
            "realizes",
            "verified-by",
            "depends-on",
            "related-to"
          ]
        },
        "target": {
          "$ref": "urn:intent:schema:common:v1#/$defs/knowledgeId"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "target",
        "required"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "related-to"
              }
            }
          },
          "then": {
            "properties": {
              "required": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "coverageSelector": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "urn:intent:schema:common:v1#/$defs/scopePath"
        },
        "mode": {
          "type": "string",
          "enum": [
            "file",
            "tree"
          ]
        },
        "role": {
          "const": "primary"
        },
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "urn:intent:schema:common:v1#/$defs/path"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        }
      },
      "required": [
        "path",
        "mode",
        "role"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "file"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "$ref": "urn:intent:schema:common:v1#/$defs/path"
              }
            },
            "not": {
              "required": [
                "exclude"
              ]
            }
          }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "assurance-limit",
            "blueprint-constraint"
          ]
        },
        "target": {
          "$ref": "urn:intent:schema:common:v1#/$defs/knowledgeId"
        },
        "localFact": {
          "$ref": "#/$defs/entryId"
        },
        "targetFact": {
          "$ref": "#/$defs/entryId"
        }
      },
      "required": [
        "type",
        "target",
        "localFact",
        "targetFact"
      ],
      "additionalProperties": false
    },
    "entryId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "behavior"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^behavior\\."
          },
          "conflicts": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "assurance"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^assurance\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "blueprint"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^blueprint\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "description"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^description\\."
          },
          "conflicts": {
            "maxItems": 0
          }
        },
        "required": [
          "coverage"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "check"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^check\\."
          },
          "conflicts": {
            "maxItems": 0
          }
        },
        "required": [
          "subjects",
          "evidenceKinds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "discipline"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^discipline\\."
          },
          "conflicts": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "current"
          }
        }
      },
      "then": {
        "properties": {
          "owners": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "discipline"
          }
        }
      },
      "then": {
        "properties": {
          "owners": {
            "minItems": 1,
            "maxItems": 1
          },
          "sources": {
            "items": {
              "properties": {
                "required": {
                  "const": false
                }
              }
            }
          },
          "relationships": {
            "items": {
              "properties": {
                "type": {
                  "const": "related-to"
                },
                "required": {
                  "const": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "assurance"
          }
        }
      },
      "then": {
        "properties": {
          "conflicts": {
            "items": {
              "properties": {
                "type": {
                  "const": "assurance-limit"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "blueprint"
          }
        }
      },
      "then": {
        "properties": {
          "conflicts": {
            "items": {
              "properties": {
                "type": {
                  "const": "blueprint-constraint"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "coverage"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "description"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "subjects"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "check"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "evidenceKinds"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "check"
          }
        }
      }
    }
  ],
  "$comment": "Authored JSON contains identity, provenance and literal selectors only. H1, opening paragraph and declared Markdown sections own title, summary and substantive meaning."
}
